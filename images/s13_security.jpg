m-form button.vews-item{width:100%;background:0 0;border:none;outline:0;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;padding:0}.center-action-wrapper{flex:1.2;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;position:relative;height:100%}.center-action-btn{position:absolute;top:-20px;width:56px;height:56px;background:linear-gradient(135deg,var(--vr-theme-color) 0,var(--vr-block-color) 100%)!important;border-radius:50%;display:flex;justify-content:center;align-items:center;color:#fff!important;text-decoration:none!important;border:3px solid #fff;box-shadow:0 6px 15px rgba(13,110,253,.4);animation:pulse-hint 2.5s infinite ease-in-out;transition:border-color .3s}.center-action-btn:active{animation:none;transform:scale(.92)}.center-action-btn .material-symbols-outlined{font-size:28px;margin:0}.center-text-label{position:absolute;bottom:-2px;font-size:11px;font-weight:600;color:#777}.center-action-btn:active,.center-action-btn:focus,.center-action-btn:hover{color:#fff!important}.center-action-btn:hover .material-symbols-outlined{color:#fff!important}@keyframes pulse-hint{0%{transform:translateY(0) scale(1);box-shadow:0 4px 12px rgba(13,110,253,.4)}50%{transform:translateY(-4px) scale(1.03);box-shadow:0 8px 20px rgba(13,110,253,.7)}100%{transform:translateY(0) scale(1);box-shadow:0 4px 12px rgba(13,110,253,.4)}}@media (min-width:600px){.bottom-nav-wrapper,.top-nav{display:none!important}}.dark-mode .top-nav{background:#1e1e1e;border-bottom:1px solid rgba(255,255,255,.1)}.dark-mode .top-nav a{color:#fff}.dark-mode .bottom-nav-wrapper{filter:drop-shadow(0 -3px 6px rgba(0, 0, 0, .5))}.dark-mode .bottom-nav-bg{background-color:#1e1e1e}.dark-mode .vews-item{color:#aaa}.dark-mode .center-text-label{color:#aaa}.dark-mode .center-action-btn{border:3px solid #1e1e1e}.dark-mode .ticker-list li a{color:#e0e0e0!important}.dark-mode .ticker-list li a:hover{color:var(--theme-accent-red)!important}.dark-mode .user-list-item .users-list-name{color:#fff!important;text-shadow:0 1px 3px rgba(0,0,0,.8)}.dark-mode .stylish-ticker{background-color:#1e1e1e!important;border:1px solid #333}.adsbygoogle,.google-auto-placed{max-width:100%;overflow:hidden;display:block!important}iframe,img{max-width:100%;height:auto}@media (min-width:992px){.live-updates-container{position:relative;padding-left:40px;border-left:2px dashed #ddd;margin-left:20px}.live-update-item::before{content:'';position:absolute;left:-51px;top:20px;width:20px;height:20px;background:#ff4757;border:4px solid #fff;border-radius:50%;box-shadow:0 0 0 3px rgba(255,71,87,.2)}}.post-text{color:#222!important;font-size:18px!important;line-height:1.75!important;font-weight:400!important;letter-spacing:.2px!important}@media (max-width:768px){.post-text{font-size:16px!important;line-height:1.7!important}}.post-text p{margin-bottom:16px!important}.dark-mode .post-text{color:#e4e4e4!important;font-size:18px!important;line-height:1.75!important;font-weight:400!important;letter-spacing:.2px!important}@media (max-width:768px){.dark-mode .post-text{font-size:16px!important;line-height:1.7!important}}.dark-mode .post-text{margin-bottom:16px!important}@media (min-width:769px){.mobile-menu-bar,.sub-menu{display:none!important}}.mobile-menu-bar{position:sticky;top:0;z-index:9991;display:flex;align-items:center;height:40px;background:#fff;border-bottom:1px solid #eee;box-shadow:0 2px 4px rgba(0,0,0,.05)}.menu-scroll{display:flex;overflow-x:auto;white-space:nowrap;height:100%;align-items:center;scrollbar-width:none}.menu-scroll::-webkit-scrollbar{display:none}.menu-scroll a{padding:0 12px;font-size:14px;font-weight:600;color:#111;text-decoration:none;flex-shrink:0}.sub-menu{position:fixed;background:rgba(255,255,255,.98);min-width:180px;border-radius:12px;box-shadow:0 10px 25px rgba(0,0,0,.15)!important;display:none;z-index:1000000;padding:8px 0;border:1px solid #eee;animation:menuFade .2s ease-out}@keyframes menuFade{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}.sub-menu a{display:flex;align-items:center;padding:12px 16px;font-size:14px;color:#333;text-decoration:none}.sub-menu a:active{background:#f5f5f5}body.dark-mode .mobile-menu-bar{background:#1a1a1a;border-bottom:1px solid #333}body.dark-mode .menu-scroll a{color:#eee}body.dark-mode .sub-menu{background:#252525;border:1px solid #444}body.dark-mode .sub-menu a{color:#ddd}.cat-title{display:flex;align-items:center;margin:22px 0}.cat-title::before{content:"";width:4px;height:20px;background:var(--vr-block-color)!important;border-radius:2px;margin-right:10px}.cat-title h2{display:flex;align-items:center;font-size:21px;font-weight:700;margin:0;white-space:nowrap;color:var(--vr-block-color)!important}.cat-title h2 .last-word{background:var(--vr-theme-color);color:#fff!important;padding:2px 14px 2px 8px;margin-left:4px;font-size:13px;font-weight:700;text-transform:uppercase;clip-path:polygon(0 0,85% 0,100% 50%,85% 100%,0 100%);position:relative;z-index:2}.cat-title .line{flex:1;height:2px;margin-left:10px;background:linear-gradient(to right,var(--vr-theme-color) 0,rgba(0,0,255,.1) 90%,transparent 100%)!important;z-index:1}.cat-title h2:has(.last-word)+.line{margin-left:-5px!important}.cat-title a{margin-left:12px;font-size:13px;text-decoration:none;color:#444;font-weight:700}.section-web-stories-widget{margin-bottom:0!important;padding:10px 0 0 0!important;border-bottom:none!important;background:0 0}.widget-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px!important;padding:0 5px}.widget-title{margin:0;font-size:20px;font-weight:800;color:#222;display:flex;align-items:center;gap:8px}.icon-pulse{animation:pulse-animation 2s infinite}@keyframes pulse-animation{0%{transform:scale(1);opacity:1}50%{transform:scale(1.1);opacity:.8}100%{transform:scale(1);opacity:1}}.view-all-btn{font-size:14px;font-weight:600;color:#666;text-decoration:none!important;display:flex;align-items:center;gap:4px}.stories-scroll-wrapper{display:flex;overflow-x:auto;gap:12px;padding:5px 5px 15px 5px!important;margin-bottom:0!important;-webkit-overflow-scrolling:touch;scrollbar-width:none;scroll-snap-type:x mandatory}.stories-scroll-wrapper::-webkit-scrollbar{display:none!important}.story-card-item{flex:0 0 auto;width:135px;height:230px;text-decoration:none!important;transition:transform .3s ease}.story-card-item:hover{transform:translateY(-5px)}.story-card-inner{width:100%;height:100%;border-radius:16px;overflow:hidden;position:relative;background:#000;box-shadow:0 4px 12px rgba(0,0,0,.15)}.story-card-inner img{width:100%!important;height:100%!important;object-fit:cover!important;display:block;transition:transform .5s ease}.story-card-item:hover img{transform:scale(1.08)}.card-overlay{position:absolute;bottom:0;left:0;width:100%;padding:40px 12px 12px 12px;background:linear-gradient(to top,rgba(0,0,0,.95) 0,rgba(0,0,0,.4) 70%,transparent 100%);z-index:5;display:flex;flex-direction:column;justify-content:flex-end}.story-widget-title{font-size:13px;line-height:1.4;color:#fff!important;font-weight:600;margin:0;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;text-shadow:0 1px 3px rgba(0,0,0,.8)}.story-pic-count{position:absolute;top:10px;left:10px;z-index:6;background:rgba(0,0,0,.6);color:#fff;font-size:11px;font-weight:700;padding:3px 10px;border-radius:20px;display:flex;align-items:center;gap:4px;backdrop-filter:blur(4px);border:1px solid rgba(255,255,255,.1)}.play-icon-box{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);z-index:4;opacity:.9}.play-icon-box .material-symbols-outlined{font-size:40px;color:#fff;font-variation-settings:'FILL' 1}.dark-mode .widget-title{color:#fff!important}.dark-mode .view-all-btn{color:#ccc!important}.dark-mode .section-web-stories-widget{border:none!important}.dark-mode .live-title,.dark-mode .live-updates-container,.dark-mode .timeline-text{color:#fff!important}@media (max-width:768px){.story-card-item{width:125px;height:210px}}/* 1. Fix Word Reversal in all Flexbox Titles */
[dir="rtl"] .cat-title,
[dir="rtl"] .vw-premium-title-wrap,
[dir="rtl"] .vw-stylish-title-wrap,
[dir="rtl"] .vw-story-head .title,
[dir="rtl"] .vw-b6-header,
[dir="rtl"] .vw-latest-premium .section-title,
[dir="rtl"] .cw-widget-head,
[dir="rtl"] .vw-mob-feat-title {
    direction: rtl !important;
    flex-direction: row !important;
    unicode-bidi: isolate !important;
}

/* 2. Enforce Strict RTL Text Alignment on all Headings */
[dir="rtl"] .auto-title, 
[dir="rtl"] .vw-b6-title,
[dir="rtl"] .vw-premium-title, 
[dir="rtl"] .vw-story-head .title,
[dir="rtl"] .vw-sc-title,
[dir="rtl"] .vw-title,
[dir="rtl"] .cw-title {
    text-align: right !important;
    direction: rtl !important;
    unicode-bidi: isolate !important;
}
/* 3. Fix Line Margins in Headers */
[dir="rtl"] .cat-title .line,
[dir="rtl"] .vw-story-head .line {
    margin: 0 15px 0 0 !important; 
}
/* 4. Fix Red Accent Lines (::after) - Move from Left to Right */
[dir="rtl"] .cat-title .line::after,
[dir="rtl"] .vw-story-head .line::after,
[dir="rtl"] .vw-premium-title-wrap::after,
[dir="rtl"] .vw-premium-title::after,
[dir="rtl"] .vw-mob-feat-title::after,
[dir="rtl"] .vw-b6-title::after,
[dir="rtl"] .vw-footer-title::after {
    left: auto !important;
    right: 0 !important;
}
[dir="rtl"] .cw-widget-head::after {
    left: auto !important;
    right: 14px !important;
}

[dir="rtl"] .vw-stylish-title::after {
    right: auto !important;
    left: -10px !important;
    border-width: 10px 10px 10px 0 !important;
    border-color: transparent #dc3545 transparent transparent !important;
}

[dir="rtl"] .vw-title-line {
    margin-left: 0 !important;
    margin-right: 20px !important;
    background: linear-gradient(-90deg, #dc3545, transparent) !important;
}

.cat-title a {
    flex-shrink: 0 !important;
    white-space: nowrap !important;
    font-size: 14px;
    font-weight: 600;
}

[dir="rtl"] .cat-title a {
    margin-right: 15px !important;
    margin-left: 0 !important;
}

[dir="rtl"] .vw-title-line {
    background: linear-gradient(-90deg, #1A2B4C, transparent) !important;
}

[dir="rtl"] .vw-stylish-title::after {
    border-color: transparent #1A2B4C transparent transparent !important;
}

html[dir="rtl"] .cat-title::before {
    display: none !important;
}

html[dir="rtl"] .cat-title {
    display: flex !important;
    justify-content: space-between !important;
    align-items: center !important;
    width: 100% !important;
}
