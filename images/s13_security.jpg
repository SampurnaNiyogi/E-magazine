ative;width:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;overflow:hidden}.fkp-ad-label{display:block;font-size:11px;color:#888;text-transform:uppercase;letter-spacing:1px;margin-bottom:5px;font-weight:500;text-align:center}.bn-content{display:flex;justify-content:center;width:100%}.bn-inner{display:block;margin:0 auto;overflow:hidden}.bn-inner:empty{display:none!important}.fkp-ad-wrapper:has(.bn-inner:empty){display:none!important}

