<style>
/* Hides header/footer when modal is open */
body.story-modal-open .main-header,
body.story-modal-open header,
body.story-modal-open .bottom-menu,
body.story-modal-open .mnav {
    display: none !important;
}

/* Scoped styles for the Stories feature - Final */
:root {
    --story-card-bg: #131418;
    --story-fg: #f2f4f6;
    --story-muted: #9aa0a6;
    --story-border: #ffffff1f;
    --story-chip-bg: #ffffff14;
    --story-chip-border: #ffffff1f;
}

.stories-overlay {
    position: fixed; top: 0; left: 0; width: 100%; height: 100%;
    background-color: rgba(0, 0, 0, 0.95); display: flex;
    justify-content: center; align-items: center; z-index: 10000;
    -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px);
}

.stories-container {
    width: 100%; max-width: 380px; height: 80vh; max-height: 750px;
    position: relative; border-radius: 18px; overflow-y: scroll;
    overflow-x: hidden; scroll-snap-type: y mandatory;
    -webkit-overflow-scrolling: touch;
}

.stories-container::-webkit-scrollbar { display: none; }
.stories-container { scrollbar-width: none; }

/* ==========================================
   TRUE REELS/STORIES DESIGN (No Black Space)
========================================== */
.story-card {
    width: 100%; height: 100%; flex-shrink: 0; scroll-snap-align: start;
    background-color: #000;
    border-radius: 18px; overflow: hidden;
    position: relative; /* Magic happens here */
    border: 1px solid var(--story-border);
}

.story-card-link { 
    display: block; text-decoration: none; 
    position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 1;
}

/* Image 100% screen cover karegi */
.story-card .cover { 
    position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 1; 
}
.story-card .cover img {
    width: 100%; height: 100%;
    object-fit: cover; /* Kala background khatam */
    display: block; 
}

/* Gradient taaki text saaf dikhe */
.img-gradient-overlay {
    position: absolute; bottom: 0; left: 0; width: 100%; height: 65%;
    background: linear-gradient(to top, rgba(0,0,0,0.95) 0%, rgba(0,0,0,0.6) 45%, transparent 100%);
    pointer-events: none;
}

/* Body (Text, Title, Profile) bottom me rahega */
.story-card .body {
    position: absolute; bottom: 0; left: 0; width: 100%; z-index: 3;
    padding: 20px 15px 45px 15px; /* Niche padding taaki badges ke liye jagah bache */
    display: flex; flex-direction: column; gap: 8px;
    pointer-events: none; /* Clicks piche jane dega */
}
.story-card .body * { pointer-events: auto; } /* Buttons ko clickable rakhega */

.story-card .topline { display: flex; align-items: center; gap: .5rem; flex-wrap: wrap; }
.story-card .chip {
    padding: 4px 12px; border-radius: 999px; font-size: 0.8rem; font-weight: 700; line-height: 1;
}
.story-card .chip.video-badge { background: #ffd166; color: #111; border: none; }
.story-card .chip.category-chip { background: rgba(255,255,255,0.2); border: 1px solid rgba(255,255,255,0.3); color: #fff; backdrop-filter: blur(4px); }
.story-card .like-btn-wrapper { margin-left: auto; }
.story-card .like-btn-wrapper .chip {
    padding: 4px 8px; cursor: pointer; display: inline-flex;
    align-items: center; gap: 4px; color: #fff;
}
.story-card .fs-like-btn.is-liked { background-color: rgba(255,0,0,0.2); border-color: rgba(255,0,0,0.4); }
.story-card .fs-like-btn.is-liked .fs-badge__icon { fill: #ff3b3b !important; }

.story-card h3.title {
    margin: 0; font-weight: 900; font-size: 1.3rem; line-height: 1.35;
    color: #fff; text-shadow: 0 1px 4px rgba(0,0,0,0.8);
    display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
}
.story-card h3.title a { color: inherit; text-decoration: none; }

.story-card p.excerpt {
    margin: 0; color: #ddd; font-size: 0.95rem; text-shadow: 0 1px 2px rgba(0,0,0,0.8);
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
}

.story-card .byline {
    margin-top: 5px;
    display: flex; align-items: center; gap: 10px;
}
.story-card .byline img { width: 38px; height: 38px; border-radius: 50%; object-fit: cover; border: 1px solid #fff; }
.story-card .byline strong { font-weight: 700; color: #fff; font-size: 0.9rem; text-shadow: 0 1px 2px rgba(0,0,0,0.8); }
.story-card .byline .verified-badge { width: 16px; height: 16px; vertical-align: middle; margin-left: 3px; }
.story-card .byline .small { font-size: 0.8rem; color: #bbb; margin-top: 2px; }

.fs-badges {
    position: absolute; right: 12px; bottom: 12px;
    display: flex; gap: 8px; z-index: 5;
}
.fs-badge {
    display: inline-flex; align-items: center; gap: 5px; padding: 5px 10px;
    border-radius: 20px; font: 700 13px/1 system-ui, sans-serif;
    background: rgba(0,0,0,0.4); color: #fff;
    border: 1px solid rgba(255,255,255,0.2); backdrop-filter: blur(5px);
}
.fs-badge i { font-size: 14px; }

/* Ad Card, Close Btn, Loader... */
.stories-close-btn {
    position: absolute; top: 15px; right: 15px; background: rgba(255,255,255,0.2); color: white;
    border: 1px solid rgba(255,255,255,0.3); border-radius: 50%; width: 40px; height: 40px; font-size: 24px;
    cursor: pointer; z-index: 10003; display: grid; place-items: center; backdrop-filter: blur(4px);
}
.story-loader { border: 4px solid #f3f3f333; border-top: 4px solid #fff; border-radius: 50%; width: 50px; height: 50px; animation: spin 1s linear infinite; margin: auto; }
@keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }

/* Ad Card */
.story-ad-card {
    display: flex; justify-content: center; align-items: center; padding: 20px;
    background-color: #000; box-sizing: border-box; width: 100%; height: 100%;
    flex-shrink: 0; scroll-snap-align: start; border-radius: 18px; border: 1px solid var(--story-border);
}
.story-ad-card .story-ad-content {
    width: 100%; height: auto; min-height: 250px;
    display: flex; justify-content: center; align-items: center;
}
.story-ad-card .adsbygoogle {
    width: 100% !important; height: 100% !important;
}
/* ==========================================
   RTL SUPPORT FOR STORIES MODAL
========================================== */
html[dir="rtl"] .stories-close-btn { right: auto; left: 15px; }
html[dir="rtl"] .fs-badges { right: auto; left: 12px; }
html[dir="rtl"] .story-card .like-btn-wrapper { margin-left: 0; margin-right: auto; }
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const storiesOverlay = document.getElementById('stories-overlay');
    const storiesContainer = document.getElementById('stories-container');
    const storiesCloseBtn = document.getElementById('stories-close-btn');
    const topStoriesBtn = document.getElementById('top-stories-btn');
    const topStoriesBtnAuth = document.getElementById('top-stories-btn-auth');

    let storiesData = { posts: [], ad_content: '' };

    function createStoryCard(story) {
        const card = document.createElement('article');
        card.className = 'story-card';

        const summary = story.summary || '';
        const pageviews = story.pageviews || 0;
        const timestamp = story.timestamp || '';
        const comment_count = story.comment_count || 0;
        const post_url = story.post_url || '#';
        
        // Pura HTML update kiya gaya hai (Image background aur overlay text ke liye)
        card.innerHTML = `
            <a href="${post_url}" class="story-card-link" target="_blank">
                <div class="cover">
                    <img src="${story.image_url}" alt="${story.title}" loading="lazy">
                    <div class="img-gradient-overlay"></div>
                </div>
            </a>
            
            <div class="body">
                 <div class="topline">
                    ${story.video_label ? `<span class="chip video-badge">${story.video_label}</span>` : ''}
                    ${story.category_name ? `<span class="chip category-chip">${story.category_name}</span>` : ''}
                    <span class="badge--likes ms-auto">
                        <button type="button" class="chip category-chip btn fs-like-btn ${story.has_liked ? 'is-liked' : ''}" data-post-id="${story.id}" aria-pressed="${story.has_liked ? 'true' : 'false'}" aria-label="Like">
                            <svg class="fs-badge__icon" viewBox="0 0 24 24" aria-hidden="true" style="width:16px; height:16px; fill:#fff;"><path d="M12.1 21.35l-1.1-.99C5.14 15.36 2 12.5 2 9.28 2 7.03 3.99 5 6.3 5c1.54 0 3.04.73 3.9 1.9C11.66 5.73 13.16 5 14.7 5 17.01 5 19 7.03 19 9.28c0 3.22-3.14 6.08-8 11.08l-0.9.99z"></path></svg>
                            <span class="fs-badge__count" data-like-count="${story.id}">${story.like_count || 0}</span>
                        </button>
                    </span>
                </div>
                
                <h3 class="title">
                    <a href="${post_url}" target="_blank">${story.title}</a>
                </h3>
                <p class="excerpt">${summary}</p>
                
                <div class="byline">
                    <a href="${post_url}" target="_blank" style="display:flex; align-items:center; gap:10px; text-decoration:none;">
                        <img src="${story.author.avatar}" alt="${story.author.name}" loading="lazy">
                        <div>
                            <strong>${story.author.name}</strong>
                            <div class="small">${timestamp}</div>
                        </div>
                    </a>
                </div>
            </div>
            
            <div class="fs-badges">
                <span class="fs-badge">
                    <i class="fa fa-comment-o"></i>
                    <span>${comment_count}</span>
                </span>
                <span class="fs-badge">
                    <i class="fa fa-eye"></i>
                    <span>${pageviews}</span>
                </span>
            </div>
        `;
        return card;
    }
    
    function createAdCard(adHtml) {
        const card = document.createElement('div');
        card.className = 'story-ad-card'; 
        card.innerHTML = `<div class="story-ad-content">${adHtml || ''}</div>`;
        return card;
    }

    function renderStories() {
        storiesContainer.innerHTML = '';
        const allItems = [...storiesData.posts];
        
        if (storiesData.ad_content && storiesData.ad_content.trim() !== '') {
            const adFrequency = 4;
            for (let i = adFrequency; i <= allItems.length; i += (adFrequency + 1)) {
                allItems.splice(i, 0, { type: 'ad' });
            }
        }

        allItems.forEach(item => {
            if (item.type === 'post') {
                storiesContainer.appendChild(createStoryCard(item));
            } else if (item.type === 'ad') {
                const adCard = createAdCard(storiesData.ad_content);
                storiesContainer.appendChild(adCard);
                
                try {
                    (adsbygoogle = window.adsbygoogle || []).push({});
                } catch (e) {
                    console.error("AdSense error:", e);
                }
            }
        });
    }
    
    function openStories(event) {
        event.preventDefault();
        storiesContainer.innerHTML = '<div class="story-loader"></div>';
        storiesOverlay.style.display = 'flex';
        document.body.classList.add('story-modal-open');
        
        const endpoint = this.getAttribute('data-endpoint');
        fetch(endpoint)
            .then(response => response.json())
            .then(data => {
                if (data.status === 'success' && data.posts.length > 0) {
                    storiesData = data;
                    renderStories();
                } else {
                    storiesContainer.innerHTML = '<p style="color:white; text-align:center;">No stories found.</p>';
                }
            })
            .catch(error => {
                console.error("Error fetching stories:", error);
                storiesContainer.innerHTML = '<p style="color:white; text-align:center;">Failed to load stories.</p>';
            });
    }
    
    function closeStories() {
        storiesOverlay.style.display = 'none';
        document.body.classList.remove('story-modal-open');
    }

    if(topStoriesBtn) topStoriesBtn.addEventListener('click', openStories);
    if(topStoriesBtnAuth) topStoriesBtnAuth.addEventListener('click', openStories);
    storiesCloseBtn.addEventListener('click', closeStories);
    storiesOverlay.addEventListener('click', function(e) { if (e.target === storiesOverlay || e.target === storiesContainer) closeStories(); });
});
</script>
<script defer>
document.addEventListener('DOMContentLoaded', function() {
    
    function loadThirdPartyScripts() {
        if (window.tpLoaded) return;
        window.tpLoaded = true;

        (function(d, s, id) {
            var js, fjs = d.getElementsByTagName(s)[0];
            if (d.getElementById(id)) return;
            js = d.createElement(s);
            js.id = id;
            js.src = "https://connect.facebook.net/en_US/sdk.js#xfbml=1&version=v16.0&appId=1209796537026374";
            fjs.parentNode.insertBefore(js, fjs);
        }(document, 'script', 'facebook-jssdk'));

        var igScript = document.createElement('script');
        igScript.src = "//www.instagram.com/embed.js";
        igScript.async = true;
        document.body.appendChild(igScript);
    }

    ['scroll', 'mousemove', 'touchstart', 'click'].forEach(function(e) {
        window.addEventListener(e, loadThirdPartyScripts, { once: true, passive: true });
    });
    setTimeout(loadThirdPartyScripts, 5000); 

    function renderFbIgEmbeds(container) {
        if (typeof FB !== 'undefined' && FB.XFBML) {
            FB.XFBML.parse(container);
        }
        if (typeof instgrm !== 'undefined' && instgrm.Embeds) {
            instgrm.Embeds.process();
        }
    }
    renderFbIgEmbeds(document.body);

   
    const titleElements = document.querySelectorAll(".auto-title");
    const updates = []; 

    titleElements.forEach(el => {
        let text = el.textContent.trim(); 
        let words = text.split(/\s+/);
        
        let newHtml = text;
        if (words.length > 1) {
            let lastWord = words.pop();
            newHtml = words.join(" ") + ' <span class="last-word">' + lastWord + '</span>';
        }
        updates.push({ element: el, html: newHtml });
    });

    if (updates.length > 0) {
        window.requestAnimationFrame(() => {
            updates.forEach(item => {
                item.element.innerHTML = item.html;
            });
        });
    }
    
    const header = document.getElementById('mobileHeader');
    if(header) {
        let ticking = false;
        window.addEventListener('scroll', () => {
            if (!ticking) {
                window.requestAnimationFrame(() => {
                    if (window.scrollY > 50) header.classList.add('header-scrolled');
                    else header.classList.remove('header-scrolled');
                    ticking = false;
                });
                ticking = true;
            }
        }, { passive: true });
    }

    
    const shareContainers = document.querySelectorAll('.share-container');
    shareContainers.forEach(container => {
        const toggleButton = container.querySelector('.btn-share-toggle');
        const popover = container.querySelector('.share-popover');

        if (toggleButton && popover) {
            toggleButton.addEventListener('click', (event) => {
                event.stopPropagation();
                document.querySelectorAll('.share-popover.is-active').forEach(p => {
                    if (p !== popover) p.classList.remove('is-active');
                });
                popover.classList.toggle('is-active');
            });
        }
    });

    document.addEventListener('click', () => {
        document.querySelectorAll('.share-popover.is-active').forEach(popover => {
            popover.classList.remove('is-active');
        });
    });

    const copyButtons = document.querySelectorAll('.btn-copy-link');
    copyButtons.forEach(button => {
        button.addEventListener('click', function(event) {
            event.preventDefault();
            const url = this.getAttribute('data-url');
            const title = this.getAttribute('data-title');
            const textToCopy = `${title}\n${url}`;

            navigator.clipboard.writeText(textToCopy).then(() => {
                const tooltip = document.createElement('span');
                tooltip.textContent = 'Copied!';
                tooltip.className = 'copy-tooltip';
                this.appendChild(tooltip);
                setTimeout(() => tooltip.remove(), 1500); 
            }).catch(err => console.error('Failed to copy text: ', err));
        });
    });

    
    setTimeout(function() {
        let adWrappers = document.querySelectorAll('.fkp-ad-wrapper');
        let wrappersToHide = []; 

        adWrappers.forEach(function(wrapper) {
            let adInner = wrapper.querySelector('.bn-inner');
            if (adInner && adInner.clientHeight < 10) {
                wrappersToHide.push(wrapper); 
            }
        });

        if (wrappersToHide.length > 0) {
            window.requestAnimationFrame(function() {
                wrappersToHide.forEach(function(wrapper) {
                    wrapper.style.display = 'none';
                });
            });
        }
    }, 2500);

   
    if (typeof $ !== 'undefined') {
        
        $('#load-more-updates').on('click', function() {
            var button = $(this);
            var offset = button.data('offset');
            var postId = button.data('post-id');
            var loader = $('#load-more-loader');

            button.hide();
            if (loader.length) loader.show();

            $.ajax({
                type: 'POST',
                url: VrConfig.baseURL + '/Ajax/loadMoreLiveUpdates',
                data: {
                    'post_id': postId,
                    'offset': offset,
                    [VrConfig.csrfTokenName]: $('meta[name="X-CSRF-TOKEN"]').attr('content')
                },
                success: function(response) {
                    if (response.status == 1 && response.html.trim() !== '') {
                        $('.timeline').append(response.html);
                        button.data('offset', offset + 5);
                        button.show();
                    } else {
                        $('#load-more-container').html('<p>No more updates to show.</p>');
                    }
                    if (loader.length) loader.hide();
                },
                error: function() {
                    if (loader.length) loader.hide();
                    button.show();
                }
            });
        });

        var videoCarousel = $('#video-carousel-container');
        if (videoCarousel.length > 0 && !videoCarousel.hasClass('slick-initialized')) {
            videoCarousel.slick({
                dots: false, infinite: true, speed: 300, slidesToShow: 4, slidesToScroll: 1, autoplay: false,
                lazyLoad: 'ondemand', rtl: (typeof VrConfig !== 'undefined' && VrConfig.rtl === true),
                prevArrow: $('#video-carousel-navigation .prev'), nextArrow: $('#video-carousel-navigation .next'),
                responsive: [
                    { breakpoint: 1200, settings: { slidesToShow: 3 } },
                    { breakpoint: 992,  settings: { slidesToShow: 2 } },
                    { breakpoint: 767,  settings: { slidesToShow: 1 } }
                ]
            });
        }

        var liveUpdatesCarousel = $('#live-updates-carousel');
        if (liveUpdatesCarousel.length > 0 && !liveUpdatesCarousel.hasClass('slick-initialized')) {
            liveUpdatesCarousel.slick({
                dots: false, infinite: true, speed: 300, slidesToShow: 4, slidesToScroll: 1,
                autoplay: true, autoplaySpeed: 5000, lazyLoad: 'ondemand',
                rtl: (typeof VrConfig !== 'undefined' && VrConfig.rtl === true),
                prevArrow: $('#live-updates-nav .prev'), nextArrow: $('#live-updates-nav .next'),
                responsive: [
                    { breakpoint: 1200, settings: { slidesToShow: 3 } },
                    { breakpoint: 992,  settings: { slidesToShow: 2 } },
                    { breakpoint: 767,  settings: { slidesToShow: 1 } }
                ]
            });
        }
    }
});
</script>
</body>
</html>
