<script>
document.addEventListener('DOMContentLoaded', function () {
    const verificationModal = new bootstrap.Modal('#modalVerification');

    document.querySelectorAll('.verified-badge').forEach(badge => {
        badge.addEventListener('click', function () {
            const type = this.dataset.type;
            const date = this.dataset.date || 'N/A';
            const info = this.dataset.info || '';

            let title = '';
            let desc = '';
            let meta = '';

            switch (type) {
                case 'gold':
                    title = 'Verified Media or Organization';
                    desc = 'News agencies, media houses, and official institutions. Trusted sources with editorial standards.';
                    break;
                case 'gray':
                    title = 'Official | Verified Expert';
                    desc = 'Journalists, officials, doctors, engineers, NGOs, and web designers. Verified professionals in public or expert roles.';
                    break;
                case 'blue':
                    title = 'Verified Public Figure';
                    desc = 'Celebrities, politicians, influencers, and thought leaders. Recognized public figures with verified identities.';
                    break;
                case 'green':
                    title = 'Verified Local Voice';
                    desc = 'Community reporters, grassroots activists, and local experts. Verified contributors from active local voices.';
                    break;
                default:
                    title = 'Verified Public Figure';
                    desc = '';
                    meta = '';
                    break;
            }

            document.getElementById('modalBadgeIcon').innerHTML = getVerificationIcon(type, '70');
            document.getElementById('modalBadgeTitle').textContent = title;
            document.getElementById('modalVerificationDate').textContent = date;
            document.getElementById('modalDescription').textContent = desc;
            document.getElementById('modalVerificationData').textContent = info;

            verificationModal.show();
        });
    });

    function getVerificationIcon(type, size = '24') {
        const sizeAttr = `width="${size}" height="${size}"`;
        switch (type) {
            case 'blue':
                return `<svg class="blue" viewBox="0 0 24 24" width="${size}" height="${size}">
                    <g><path d="M22.25 12c0-1.43-.88-2.67-2.19-3.34.46-1.39.2-2.9-.81-3.91s-2.52-1.27-3.91-.81c-.66-1.31-1.91-2.19-3.34-2.19s-2.67.88-3.33 2.19c-1.4-.46-2.91-.2-3.92.81s-1.26 2.52-.8 3.91c-1.31.67-2.2 1.91-2.2 3.34s.89 2.67 2.2 3.34c-.46 1.39-.21 2.9.8 3.91s2.52 1.26 3.91.81c.67 1.31 1.91 2.19 3.34 2.19s2.68-.88 3.34-2.19c1.39.45 2.9.2 3.91-.81s1.27-2.52.81-3.91c1.31-.67 2.19-1.91 2.19-3.34zm-11.71 4.2L6.8 12.46l1.41-1.42 2.26 2.26 4.8-5.23 1.47 1.36-6.2 6.77z"></path></g>
                </svg>`;
            case 'gray':
                return `<svg class="silver" viewBox="0 0 24 24" width="${size}" height="${size}">
                    <g><path d="M22.25 12c0-1.43-.88-2.67-2.19-3.34.46-1.39.2-2.9-.81-3.91s-2.52-1.27-3.91-.81c-.66-1.31-1.91-2.19-3.34-2.19s-2.67.88-3.33 2.19c-1.4-.46-2.91-.2-3.92.81s-1.26 2.52-.8 3.91c-1.31.67-2.2 1.91-2.2 3.34s.89 2.67 2.2 3.34c-.46 1.39-.21 2.9.8 3.91s2.52 1.26 3.91.81c.67 1.31 1.91 2.19 3.34 2.19s2.68-.88 3.34-2.19c1.39.45 2.9.2 3.91-.81s1.27-2.52.81-3.91c1.31-.67 2.19-1.91 2.19-3.34zm-11.71 4.2L6.8 12.46l1.41-1.42 2.26 2.26 4.8-5.23 1.47 1.36-6.2 6.77z"></path></g>
                </svg>`;
            case 'gold':
                return `<svg class="admin" viewBox="0 0 24 24" width="${size}" height="${size}">
                    <g>
