<script>
document.querySelectorAll('.dropdown-trigger').forEach(trigger => {
    trigger.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();

        const targetId = this.getAttribute('data-target');
        const menu = document.getElementById(targetId);
        
        // Toggle Logic
        const isVisible = menu.style.display === 'block';
        
        // Pehle sab band karo
        document.querySelectorAll('.sub-menu').forEach(m => m.style.display = 'none');

        if (!isVisible) {
            const rect = this.getBoundingClientRect();
            menu.style.top = (rect.bottom + 5) + 'px'; // Thoda gap niche
            
            // Screen se bahar na jaye uske liye logic
            let leftPos = rect.left;
            if (leftPos + 180 > window.innerWidth) {
                leftPos = window.innerWidth - 190;
            }
            menu.style.left = leftPos + 'px';
            menu.style.display = 'block';
        }
    });
});

document.addEventListener('click', () => {
    document.querySelectorAll('.sub-menu').forEach(m => m.style.display = 'none');
});
</script></header>

<script>
document.addEventListener("DOMContentLoaded", function () {
    // --- START OF Z-INDEX FIX SCRIPT ---
    var modalElement = document.getElementById('modalLogin');
    if (modalElement) {
        modalElement.addEventListener('shown.bs.modal', function () {
            this.style.zIndex = '999999';
            var backdrop = document.querySelector('.modal-backdrop');
            if (backdrop) {
                backdrop.style.zIndex = '999998';
            }
        });
    }
    // --- END OF Z-INDEX FIX SCRIPT ---

    // --- START: Updated logic for OTP/Password toggle (Modern Style) ---
    if ($('#btn-login-otp-modal').length) {
        const passwordContainer = $('#password-container-modal');
        const passwordInput = passwordContainer.find('input[name="password"]');
        const loginTypeInput = $('#login_type_modal');
        const submitButton = $('#submit-button-modal');
        const btnOtp = $('#btn-login-otp-modal');
        const btnPassword = $('#btn-login-password-modal');

        btnOtp.on('click', function() {
            passwordContainer.slideUp(200);
            passwordInput.prop('required', false);
            loginTypeInput.val('otp');
            submitButton.html('Get Login Code <i class="material-symbols-outlined" style="font-size: 18px; vertical-align: middle;">arrow_forward</i>');
            
            // Modern Class Toggle
            btnOtp.addClass('active');
            btnPassword.removeClass('active');
        });

        btnPassword.on('click', function() {
            passwordContainer.slideDown(200);
            passwordInput.prop('required', true);
            loginTypeInput.val('password');
            submitButton.text('Login');
            
            // Modern Class Toggle
            btnPassword.addClass('active');
            btnOtp.removeClass('active');
        });
    }
    // --- END: Updated logic ---


    // --- Resend OTP logic for Modal ---
    $('#resend-otp-btn-modal').on('click', function(e) {
        e.preventDefault();
        var email = $('#otp_email_modal').val();
        var $successMsg = $('#resend-success-message');
        var data = new FormData();
        data.append('email', email);
        data.append('action', 'login');
        data.append(VrConfig.csrfTokenName, $('meta[name="X-CSRF-TOKEN"]').attr('content'));

        $.ajax({
            url: VrConfig.baseURL + '/resend-otp-post',
            type: 'POST',
            data: data,
            processData: false,
            contentType: false,
            dataType: 'json',
            success: function(obj) {
                if (obj.result === 1) {
                    $successMsg.removeClass('d-none').show().delay(3000).fadeOut();
                    startResendTimer('modal', 60); 
                } else if (obj.result === 'limit_exceeded') {
                    $('#result-otp-verify-modal').html('<div class="alert alert-danger">' + obj.message + '</div>');
                    startResendTimer('modal', obj.remaining_time);
                } else {
                    $('#result-otp-verify-modal').html('<div class="alert alert-danger">' + obj.message + '</div>');
                }
            }
        });
    });

    // --- "Change Email" button logic ---
    $('#change-email-btn').on('click', function(e){
        e.preventDefault();
        $('#loginModalTitle').text('Login');
        $('#otp-form-container').addClass('d-none');
        $('#login-form-container').removeClass('d-none');
        $('#result-otp-verify-modal').html('');
    });
});

// --- Main Login Form Submission Function (UPDATED) ---
function handleLoginPopupSubmit(event) {
    event.preventDefault();
    const $form = $("#form-login");
    const $button = $form.find('button[type="submit"]');
    const originalButtonText = $button.text();
    const loginType = $('#login_type_modal').val();
    const waitingText = (loginType === 'otp') ? 'Sending...' : 'Please wait...';
    
    $button.prop("disabled", true).text(waitingText);
    
    var serializedData = $form.serializeArray();
    serializedData.push({name: 'sysLangId', value: VrConfig.sysLangId});
    serializedData.push({name: 'login_from', value: 'modal'});
    serializedData.push({name: VrConfig.csrfTokenName, value: $('meta[name="X-CSRF-TOKEN"]').attr('content')});

    $.ajax({
        url: VrConfig.baseURL + '/Auth/loginPost',
        type: 'POST',
        data: $.param(serializedData),
        dataType: 'json',
        success: function (obj) {
            // START: NEW 2FA REDIRECT LOGIC FOR MODAL
            if (obj.result === '2fa_redirect') {
                // If 2FA is required, redirect the whole page
                window.location.href = obj.redirect_url;
                return;
            }
            // END: NEW 2FA REDIRECT LOGIC FOR MODAL
            if (obj.result == 1) {
                $('#modalLogin').modal('hide');
                Swal.fire({ icon: 'success', title: 'Login Successful', text: 'Redirecting...', timer: 1500, showConfirmButton: false }).then(() => { location.reload(); });
            } 
            else if (obj.result == 'otp_redirect') {
                $('#login-form-container').addClass('d-none');
                $('#otp-form-container').removeClass('d-none');
                const email = $('#login_email').val();
                $('#otp-modal-email').text(maskEmail(email));
                $('#otp_email_modal').val(email);
                setupOtpInputs('modal');
                startResendTimer('modal', 60);
            } 
            // --- START: New logic to handle "email not found" ---
            else if (obj.message === 'We could not find a user with that email address.') {
                Swal.fire({
                    icon: 'warning',
                    title: 'We could not find a user with that email address.',
                    text: 'This email is not registered with us. Would you like to create a new account?', // You might need to add this translation
                    showCancelButton: true,
                    confirmButtonText: 'Register',
                    cancelButtonText: 'Cancel'
                }).then((result) => {
                    if (result.isConfirmed) {
                        window.location.href = 'https://www.sangritoday.com/register';
                    }
                });
            }
            // --- END: New logic ---
            else {
                Swal.fire({ icon: 'error', title: '', html: obj.message, confirmButtonText: 'OK' });
            }
        },
        error: function () {
            Swal.fire({ icon: 'error', title: '', text: 'An error occurred please try again!', confirmButtonText: 'OK' });
        },
        complete: function () {
            $button.prop("disabled", false).text(originalButtonText);
        }
    });
}

// --- OTP Verification Submit Function (no changes needed here) ---
function handleOtpVerifySubmit(event) {
    event.preventDefault();
    let otp = "";
    $('#otp-inputs-modal .otp-input').each(function() { otp += $(this).val(); });
    $('#otp_code_full_modal').val(otp);

    const $form = $("#form-otp-verify-modal");
    const $button = $form.find('button[type="submit"]');
    const $resultDiv = $('#result-otp-verify-modal');
    $button.prop("disabled", true).text("Verifying...");
    $resultDiv.html('');

    $.ajax({
        url: VrConfig.baseURL + '/otp-verify-post',
        type: 'POST',
        data: $form.serialize(),
        dataType: 'json',
        success: function (obj) {
            if (obj.status === 'success') {
                $('#modalLogin').modal('hide');
                Swal.fire({ icon: 'success', title: 'Login Successful', text: 'Redirecting...', timer: 1500, showConfirmButton: false }).then(() => { window.location.reload(); });
            } else {
                $resultDiv.html('<div class="alert alert-danger">' + obj.message + '</div>');
            }
        },
        error: function(xhr) {
            $resultDiv.html('<div class="alert alert-danger">A server error occurred.</div>');
        },
        complete: function () {
            $button.prop("disabled", false).text("Login");
        }
    });
}

// --- Helper Functions (no changes needed here) ---
function startResendTimer(suffix, durationInSeconds) {
    var resendButton = $('#resend-otp-btn-' + suffix);
    var timerContainer = $('#resend-timer-container-' + suffix);
    var timerSpan = $('#resend-timer-' + suffix);
    var timeLeft = durationInSeconds > 0 ? durationInSeconds : 60;
    resendButton.hide();
    timerContainer.removeClass('d-none').show();
    timerSpan.text(timeLeft);
    if (window.otpTimer) { clearInterval(window.otpTimer); }
    window.otpTimer = setInterval(function () {
        timeLeft--;
        timerSpan.text(timeLeft);
        if (timeLeft <= 0) {
            clearInterval(window.otpTimer);
            timerContainer.addClass('d-none');
            resendButton.show();
        }
    }, 1000);
}

function setupOtpInputs(suffix) {
    const containerId = (suffix === 'modal') ? '#otp-inputs-modal' : '#otp-inputs';
    const inputs = document.querySelectorAll(`${containerId} .otp-input`);
    if (!inputs.length) return;
    inputs.forEach(input => input.value = '');
    for(let i = 1; i < inputs.length; i++) { inputs[i].disabled = true; }
    inputs[0].disabled = false;
    inputs[0].focus();
    inputs.forEach((input, index) => {
        input.addEventListener('input', () => {
            if (input.value.length === 1 && index < inputs.length - 1) {
                inputs[index + 1].disabled = false;
                inputs[index + 1].focus();
            }

            // --- AUTO VERIFY (Feature Added) ---
            if (index === inputs.length - 1 && input.value.length === 1) {
                setTimeout(function() {
                    // Form dhoond kar submit karega (Modal ya Normal dono ke liye chalega)
                    $(input).closest('form').submit();
                }, 300);
            }
            // -----------------------------------
        });
        input.addEventListener('keydown', (e) => {
            if (e.key === "Backspace" && index > 0 && input.value.length === 0) {
                inputs[index].disabled = true;
                inputs[index - 1].focus();
            }
        });
    });
}

function maskEmail(email) {
  if (!email) return '';
  const parts = email.split('@');
  const user = parts[0] || '';
  const domain = parts[1] || '';
  const pre = user.slice(0, 2);
  const suf = user.slice(-2);
  const maskedUser = user.length <= 4 ? '*'.repeat(user.length) : pre + '***' + suf;
  return domain ? `${maskedUser}@${domain}` : maskedUser;
}
</script>


<!-- Compact Verification Modal -->
