            position: absolute;
            top: -10px;
            right: 5px;
            background-color: #ff3b30;
            color: white;
            font-size: 0.55rem;
            font-weight: 800;
            padding: 2px 6px;
            border-radius: 10px;
            border: 1px solid #fff;
            animation: pulse-new 1.5s infinite;
            z-index: 10;
        }
        @keyframes pulse-new {
            0% { transform: scale(1); box-shadow: 0 0 0 0 rgba(255, 59, 48, 0.7); }
            70% { transform: scale(1.1); box-shadow: 0 0 0 6px rgba(255, 59, 48, 0); }
            100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(255, 59, 48, 0); }
        }
        #pwa-install-menu-btn {
            flex-direction: column; 
            align-items: center; 
            justify-content: center;
        }
        /* Dark mode overrides for modal */
        body.dark-mode .modal-content { background-color: #1a1d20; }
        body.dark-mode .modal-content h5 { color: #fff !important; }
        body.dark-mode .btn-light { background: #2b3035; color: #fff; border-color: #3b455d !important; }
    </style>

    <script>
    document.addEventListener("DOMContentLoaded", function() {
        // --- Scroll Menu Logic ---
        let lastScrollTop = 0;
        const topMenu = document.getElementById("topMenu");
        const bottomMenu = document.getElementById("bottomMenu");

        window.addEventListener("scroll", function() {
            let scrollTop = window.pageYOffset || document.documentElement.scrollTop;
            if (scrollTop > lastScrollTop && scrollTop > 50) {
                if (topMenu) topMenu.style.top = "-60px";
                if (bottomMenu) bottomMenu.style.bottom = "-90px";
            } else {
                if (topMenu) topMenu.style.top = "0";
                if (bottomMenu) bottomMenu.style.bottom = "0";
            }
            lastScrollTop = scrollTop <= 0 ? 0 : scrollTop;
        }, { passive: true });

        // --- PWA Installation Logic (SWAP SYSTEM) ---
        let deferredPrompt;
        const installBtnWrapper = document.getElementById('pwa-install-menu-btn');
        
        // Smart Check: Fallback button ke liye (Newsletter ho ya Web Story)
        const fallbackBtnWrapper = document.getElementById('fallback-newsletter') || document.getElementById('fallback-web-stories');
        const confirmInstallBtn = document.getElementById('confirmPwaInstallBtn');

        window.addEventListener('beforeinstallprompt', (e) => {
            e.preventDefault();
            deferredPrompt = e;
            
            // Swap: Fallback hide karo, Install App dikhao
            if(fallbackBtnWrapper && installBtnWrapper) {
                fallbackBtnWrapper.style.display = 'none';
                installBtnWrapper.style.display = 'flex'; 
            }
        });

        if (confirmInstallBtn) {
            confirmInstallBtn.addEventListener('click', async () => {
                var installModalEl = document.getElementById('installAppModal');
                var modalInstance = bootstrap.Modal.getInstance(installModalEl);
                if (modalInstance) {
                    modalInstance.hide();
                }

                if (deferredPrompt) {
                    deferredPrompt.prompt();
                    const { outcome } = await deferredPrompt.userChoice;
                    console.log(`PWA Install response: ${outcome}`);
                    deferredPrompt = null;
                }
            });
        }

        // Install hone par Install App chhupao, Fallback wapas dikhao
        window.addEventListener('appinstalled', () => {
            if(fallbackBtnWrapper && installBtnWrapper) {
                installBtnWrapper.style.display = 'none';
                fallbackBtnWrapper.style.display = 'flex';
            }
            deferredPrompt = null;
            console.log('App was successfully installed!');
        });
    });
    </script>

