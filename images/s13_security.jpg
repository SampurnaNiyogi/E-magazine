<style>
/* =============================================
   BASIC VARIABLES & GENERAL MODAL STYLES
   ============================================= */

:root {
    --primary-color: #4361ee;
    --secondary-color: #6c757d;
    --success-color: #06d6a0;
    --light-bg: #f8f9fa;
    --border-radius: 0.8rem;
}

.modal-content {
    border: none;
    border-radius: var(--border-radius);
    overflow: hidden;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
}

.modal-header {
    border-bottom: none;
    padding: 1.5rem 1.5rem 0.5rem;
    position: relative;
}

.modal-body {
    padding: 1.25rem;
}



/* =============================================
   1. VERIFICATION BADGE MODAL STYLES
   ============================================= */

.modal-verification {
    max-width: 400px;
}

@media (max-width: 576px) {
    .modal-verification {
        max-width: 95%;
        margin: 0.5rem auto;
    }
}

.modal-verification .modal-title {
    font-weight: 700;
    font-size: 1.3rem;
    color: #333;
    text-align: center;
    width: 100%;
    margin-bottom: 0.5rem;
}

.verification-badge {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: #e1e1e1;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 0.75rem;
    animation: pulse 2s infinite;
    overflow: hidden;
    box-shadow:
        0 0 0 4px rgba(6, 214, 160, 0.2),
        0 0 10px rgba(6, 214, 160, 0.4),
        0 0 20px rgba(6, 214, 160, 0.3),
        0 0 40px rgba(6, 214, 160, 0.1);
}

@keyframes pulse {
    0% { box-shadow: 0 0 0 0 rgba(6, 214, 160, 0.7); }
    70% { box-shadow: 0 0 0 10px rgba(6, 214, 160, 0); }
    100% { box-shadow: 0 0 0 0 rgba(6, 214, 160, 0); }
}

.verification-badge svg {
    width: 36px;
    height: 36px;
    display: block;
    margin: 0;
    padding: 0;
}

.verification-title {
    text-align: center;
    font-weight: 700;
    margin-bottom: 1rem;
    color: #333;
    font-size: 1.1rem;
}

.verification-details {
    background-color: var(--light-bg);
    border-radius: var(--border-radius);
    padding: 1rem;
    margin-bottom: 1rem;
}

.verification-item {
    display: flex;
    justify-content: space-between;
    padding: 0.5rem 0;
    border-bottom: 1px solid #e9ecef;
    font-size: 0.9rem;
}

.verification-item:last-child {
    border-bottom: none;
}

.detail-label {
    font-weight: 600;
    color: #495057;
}

.detail-value {
    color: #212529;
    text-align: right;
}

.combined-info {
    background-color: white;
    border: 1px solid #dee2e6;
    border-radius: 0.5rem;
    padding: 0.75rem;
    margin-top: 1rem;
    font-size: 0.85rem;
}

.verification-meta {
    font-size: 0.8rem;
    color: var(--secondary-color);
    margin-top: 0.5rem;
}

.btn-verified {
    background-color: var(--success-color);
    border: none;
    color: white;
    border-radius: 50px;
    padding: 0.6rem 1.25rem;
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto;
    transition: all 0.3s;
    font-size: 0.9rem;
}

.btn-verified:hover {
    background-color: #05b58c;
    transform: translateY(-2px);
    box-shadow: 0 4px 10px rgba(6, 214, 160, 0.3);
}


/* Enhanced User Login Modal Styles */
.modal-login .modal-content { border-radius: 12px; border: none; }
.modal-login .modal-header { border-bottom: none; }
.modal-login .close {
    background: none; border: none; font-size: 1.8rem;
    position: absolute; top: 10px; right: 15px; z-index: 10;
    padding: 0.5rem 1rem; line-height: 1;
}
.modal-login .modal-body { padding: 1rem 1.5rem 2rem; }

/* OTP Form specific styles */
.otp-form-modal-container .modal-icon { font-size: 48px; color: #0d6efd; margin-bottom: 1rem; vertical-align: middle; }
.otp-form-modal-container .material-symbols-outlined { vertical-align: -6px; }
.otp-form-modal-container .modal-title { font-weight: 700; font-size: 1.5rem; }
.otp-form-modal-container .otp-subtitle { color: #6c757d; margin-bottom: 1.5rem; }
.otp-form-modal-container .email-display {
    display: flex; align-items: center; justify-content: space-between;
    background-color: #f8f9fa; padding: 0.75rem 1rem;
    border-radius: 8px; margin-bottom: 1.5rem; border: 1px solid #dee2e6;
}
.otp-form-modal-container .email-display .material-symbols-outlined { margin-right: 8px; color: #0d6efd; }
.otp-form-modal-container .email-text { font-weight: 600; color: #343a40; }
.otp-form-modal-container .email-display a { font-size: 0.875rem; font-weight: 600; text-decoration: none; }
#otp-inputs-modal { display: flex; justify-content: space-between; gap: 10px; direction: ltr; margin: 1.5rem 0; }
#otp-inputs-modal .otp-input {
    width: 45px; height: 55px; text-align: center; font-size: 1.8rem;
    border: 1px solid #ced4da; border-radius: 8px; transition: all 0.2s;
}
#otp-inputs-modal .otp-input:focus { border-color: #0d6efd; box-shadow: 0 0 0 3px rgba(13, 110, 253, 0.25); }
.otp-form-modal-container .resend-container { font-size: 0.9rem; }
.otp-form-modal-container .resend-container a { font-weight: 600; text-decoration: none; }
.otp-form-modal-container .info-box {
    background-color: #e7f1ff; padding: 1rem; border-radius: 8px;
    font-size: 0.875rem; color: #052c65; display: flex; align-items: center;
    border-left: 4px solid #0d6efd;
}
.otp-form-modal-container .info-box .material-symbols-outlined { margin-right: 10px; }
.otp-form-modal-container .btn-custom { padding: 12px; font-weight: bold; border-radius: 8px; }

/*
 * FINAL & GUARANTEED FIX: Stacking Context for Modal, Ads, and SweetAlert
*/
.modal-backdrop {
  z-index: 999998 !important;
}

.modal {
  z-index: 999999 !important;
}

.swal2-container {
  z-index: 1000000 !important;
}

.modal-add-post .item {
        text-align: center;
        padding: 20px 10px;
        border-radius: 8px;
        transition: all 0.3s ease;
        height: 100%;
        cursor: pointer;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .modal-add-post .col-add-post {
        margin-bottom: 20px;
    }

    .modal-add-post .item:hover {
        background-color: #f8f9fa;
        transform: translateY(-5px);
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.08);
    }

    .modal-add-post .item .item-icon {
        margin-bottom: 15px;
    }

    .modal-add-post .icon-background {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        display: flex;
        justify-content: center;
        align-items: center;
        margin: 0 auto;
        color: #ffffff;
        transition: all 0.3s ease;
    }
    
    .modal-add-post .icon-background .material-symbols-outlined {
        font-size: 30px; 
    }

    .modal-add-post a:hover .icon-background {
        transform: scale(1.1) rotate(5deg);
    }

    .modal-add-post .item h5.title {
        font-size: 1rem;
        font-weight: 600;
        margin-bottom: 5px;
        color: #333;
    }

    .modal-add-post .item p.desc {
        font-size: 0.85rem;
        color: #6c757d;
        min-height: 40px;
    }
    
    .modal-login .btn-outline-info {
        color: #17a2b8 !important;
        border-color: #17a2b8 !important;
    }

    .modal-login .btn-outline-info:hover {
        color: #fff !important;
    }
    
    
    /* --- MODERN LOGIN MODAL STYLES (Admin Style) --- */
.toggle-container-modal {
    background: #f1f3f5;
    border-radius: 8px;
    padding: 4px;
    display: flex;
    margin-bottom: 20px;
    border: 1px solid #e9ecef;
}
.toggle-btn-modal {
    flex: 1;
    padding: 10px;
    border: none;
    background: transparent;
    color: #6c757d;
    border-radius: 6px;
    cursor: pointer;
    transition: 0.3s;
    font-size: 0.9rem;
    font-weight: 600;
}
.toggle-btn-modal.active {
    background: #fff;
    color: #4361ee; /* Primary Brand Color */
    box-shadow: 0 2px 5px rgba(0,0,0,0.05);
}

.input-group-modal {
    position: relative;
    margin-bottom: 15px;
}
.input-group-modal .icon {
    position: absolute;
    left: 15px;
    top: 50%;
    transform: translateY(-50%);
    color: #adb5bd;
    font-size: 1.1rem;
    z-index: 2;
}
.form-input-modal {
    width: 100%;
    padding: 12px 12px 12px 45px; /* Space for icon */
    border: 2px solid #e9ecef;
    border-radius: 10px;
    font-size: 0.95rem;
    transition: 0.3s;
    background: #fff;
    color: #495057;
}
.form-input-modal:focus {
    border-color: #4361ee;
    outline: none;
    box-shadow: 0 0 0 4px rgba(67, 97, 238, 0.1);
}

.btn-login-modal {
    width: 100%;
    padding: 14px;
    border: none;
    border-radius: 10px;
    background: linear-gradient(to right, #4facfe 0%, #00f2fe 100%); /* Same as Admin */
    color: #fff;
    font-weight: 700;
    font-size: 1rem;
    margin-top: 15px;
    cursor: pointer;
    transition: 0.3s;
    box-shadow: 0 4px 10px rgba(0, 242, 254, 0.3);
}
.btn-login-modal:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 15px rgba(0, 242, 254, 0.4);
}
</style><main id="main-content" role="main"><style>.container-error-404{display:flex;justify-content:center;align-items:center;min-height:600px}.error-404 h1{font-family:Verdana,Geneva,sans-serif;text-align:center;font-size:142px;line-height:142px;font-weight:700;margin-bottom:10px;text-transform:uppercase;background:linear-gradient(to right, #537895 0%, #09203F  100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent}.error-404 h2{text-align:center;font-size:24px;font-weight:600}.error-404 p{text-align:center;font-size:14px;font-weight:400}</style>
    <section class="section section-page mb-0">
